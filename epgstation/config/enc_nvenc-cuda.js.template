const spawn = require('child_process').spawn;
const execFile = require('child_process').execFile;

const ffmpeg = process.env.FFMPEG;
const ffprobe = process.env.FFPROBE;

const input = process.env.INPUT;
const output = process.env.OUTPUT;
const isDualMono = parseInt(process.env.AUDIOCOMPONENTTYPE, 10) == 2;

const args = ['-y'];

/**
 * 動画長取得関数
 * @param {string} filePath ファイルパス
 * @return number 動画長を返す (秒)
 */
const getDuration = filePath => {
  return new Promise((resolve, reject) => {
    execFile(ffprobe, ['-v', '0', '-show_format', '-of', 'json', filePath], (err, stdout) => {
      if (err) return reject(err);
      try {
        const result = JSON.parse(stdout);
        resolve(parseFloat(result.format.duration));
      } catch (e) {
        reject(e);
      }
    });
  });
};

// 字幕用
args.push('-fix_sub_duration');

// （任意）デコードをCUDAに寄せる：問題が出るなら、この2行をコメントアウトしてOK
args.push('-hwaccel', 'cuda');
args.push('-hwaccel_output_format', 'cuda');

// input 設定
args.push('-i', input);

// ビデオストリーム設定（NVENC）
args.push('-map', '0:v:0', '-c:v', 'h264_nvenc');

// インターレス解除
args.push('-vf', 'yadif_cuda');

// オーディオストリーム設定
if (isDualMono) {
  args.push(
    '-filter_complex',
    'channelsplit[FL][FR]',
    '-map', '[FL]',
    '-map', '[FR]',
    '-metadata:s:a:0', 'language=jpn',
    '-metadata:s:a:1', 'language=eng',
    '-ac', '1',
  );
} else {
  args.push('-map', '0:a:0');
}
args.push('-c:a', 'aac');

// 字幕ストリーム設定
args.push('-map', '0:s?', '-c:s', 'mov_text');

// 品質/速度設定（NVENC用）
// preset: p1(速い)〜p7(遅い/高画質)。まずは p5 が無難
// cq: 低いほど高画質（サイズ増）。目安 19〜26
args.push(
  '-preset', 'p5',
  '-rc', 'vbr',
  '-cq', '23',
  '-b:v', '4M',
  '-maxrate', '6M',
  '-bufsize', '12M',
);

// 出力ファイル
args.push(output);

(async () => {
  const duration = await getDuration(input);
  const child = spawn(ffmpeg, args);

  child.stderr.on('data', data => {
    let strbyline = String(data).split('\n');
    for (let i = 0; i < strbyline.length; i++) {
      let str = strbyline[i];
      if (!str.startsWith('frame')) continue;

      const ffmpeg_reg =
        /frame=\s*(?<frame>\d+)\sfps=\s*(?<fps>\d+(?:\.\d+)?)\sq=\s*(?<q>[+-]?\d+(?:\.\d+)?)\sL?size=\s*(?<size>\d+(?:\.\d+)?)kB\stime=\s*(?<time>\d+[:\.\d+]*)\sbitrate=\s*(?<bitrate>\d+(?:\.\d+)?)kbits\/s(?:\sdup=\s*(?<dup>\d+))?(?:\sdrop=\s*(?<drop>\d+))?\sspeed=\s*(?<speed>\d+(?:\.\d+)?)x/;

      let ffmatch = str.match(ffmpeg_reg);
      if (ffmatch === null) continue;

      let current = 0;
      const times = ffmatch.groups.time.split(':');
      for (let j = 0; j < times.length; j++) {
        if (j == 0) current += parseFloat(times[j]) * 3600;
        else if (j == 1) current += parseFloat(times[j]) * 60;
        else if (j == 2) current += parseFloat(times[j]);
      }

      const percent = current / duration;
      const log =
        'frame= ' + ffmatch.groups.frame +
        ' fps=' + ffmatch.groups.fps +
        ' size=' + ffmatch.groups.size +
        ' time=' + ffmatch.groups.time +
        ' bitrate=' + ffmatch.groups.bitrate +
        ' drop=' + (ffmatch.groups.drop ?? 0) +
        ' speed=' + ffmatch.groups.speed;

      console.log(JSON.stringify({ type: 'progress', percent: percent, log: log }));
    }
  });

  child.on('error', err => {
    console.error(err);
    throw new Error(err);
  });

  child.on('close', (code) => {
    process.exitCode = code;
  });

  process.on('SIGINT', () => {
    child.kill('SIGINT');
  });
})();
